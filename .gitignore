# ===== 시크릿 / 환경 변수 (절대 커밋 금지) =====
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# ===== Firebase 서버 관리자 키 (절대 커밋 금지) =====
# 서버가 verifyIdToken 등에 쓰는 관리자 권한 키 — 유출 시 프로젝트 전체 위험.
firebase-adminsdk-*.json
serviceAccountKey.json
# 참고: 클라이언트 설정 파일(google-services.json / GoogleService-Info.plist /
# firebase_options.dart)은 시크릿이 아니므로 커밋한다. 자세한 근거는 docs/ENV_GUIDE.md 참고.

# ===== Flutter / Dart =====
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.pub-cache/
app/.pub/
app/pubspec.lock
app/**/*.g.dart
app/**/*.freezed.dart
app/ios/Pods/
app/ios/.symlinks/
app/android/.gradle/
app/android/local.properties
app/android/key.properties
app/**/*.keystore
app/**/*.jks

# ===== Java / Spring Boot / Gradle =====
server/build/
server/.gradle/
server/out/
server/bin/
*.class
server/**/application-local.yml

# ===== IDE =====
.idea/
.vscode/
*.iml
*.ipr
*.iws

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 로그 / 임시 =====
*.log
tmp/
temp/
