# ================================================================
# FogApp 환경 변수 예시 파일
# 이 파일을 복사해 `.env` 로 만들고 실제 값을 채워 넣으세요.
#   cp .env.example .env
# ⚠️ 실제 값이 담긴 .env 는 절대 커밋하지 마세요 (.gitignore 처리됨)
# ================================================================

# ----- 한국관광공사 OpenAPI -----
# Encoding·Decoding 키 어느 쪽을 넣어도 된다 — 서버가 알아서 맞춘다(TourServiceKey).
# 앞뒤 공백은 지워지지만, 줄바꿈이 섞이지 않게만 주의할 것.
TOUR_API_SERVICE_KEY=여기에_발급받은_서비스키
# 기본값 사용 시 생략 가능. TourAPI 4.0 = KorService2.
# base-url 과 operation-suffix 는 반드시 짝이어야 한다(KorService2 + areaBasedList2).
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_OPERATION_SUFFIX=2

# ----- 스팟 수집 배치 (#5, #100) -----
# true 로 켜면 서버 기동 시 지역 목록을 수집하고, 이어서 소개글이 빈 스팟을 상세조회로 채운다.
#
# ⚠️ 한 번 돌린 뒤에는 반드시 false 로 되돌릴 것.
#    docker compose 의 server 는 restart: unless-stopped 라, true 로 둔 채 컨테이너가
#    재시작되면 목록 수집이 통째로 다시 돈다(지역 3 × 최대 10페이지 = 30회).
#    소개글 단계는 "이미 있으면 건너뛰기" 가 있지만 목록 단계에는 그런 가드가 없다.
TOUR_COLLECT_ON_STARTUP=false
# 수집할 지역 코드 (1=서울, 6=부산, 39=제주)
TOUR_COLLECT_AREA_CODES=1,6,39
# 한 번 실행에 소개글을 채울 최대 스팟 수. 상세조회는 스팟 1건당 1회라 목록보다 비싸다 —
# 남은 것은 다음 실행이 이어서 채운다. 일일 한도를 확인하기 전에는 작게 두는 편이 안전하다.
TOUR_COLLECT_OVERVIEW_MAX_PER_RUN=200

# ----- 데이터베이스 (PostgreSQL + PostGIS) -----
# docker-compose.yml 의 기본값과 맞춰져 있습니다.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fogapp
DB_USERNAME=fogapp
DB_PASSWORD=변경하세요

# ----- Naver Maps SDK -----
NAVER_MAP_CLIENT_ID=여기에_네이버_클라이언트_ID

# ----- Firebase (서버측 Admin SDK — ID 토큰 검증 #4) -----
# false(기본)면 검증기가 모든 토큰을 거부해 /api/health 외 API가 401을 반환한다.
# 서비스 계정 키를 받은 뒤 true 로 켠다. (설정 절차: docs/FIREBASE_AUTH_SETUP.md)
FIREBASE_ENABLED=false
# 서비스 계정 JSON 파일 경로 (⛔ 커밋 금지 — 서버 관리자 키)
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccountKey.json

# ----- 방문 인증 사진 (#48, #76) -----
# 사진은 서버가 직접 보관한다(Firebase Storage 는 무료 요금제에서 사용 불가).
# ⚠️ 컨테이너로 띄울 때는 이 경로가 영속 볼륨이어야 한다. docker-compose.yml 이
#    fogapp_photos 볼륨을 /app/data/visit-photos 에 붙여 이미 처리한다 —
#    직접 실행할 때만 아래 값이 쓰인다.
VISIT_PHOTO_STORAGE_PATH=./data/visit-photos
VISIT_MAX_PHOTO_BYTES=5242880
# 사용자 한 명의 총 사용량 상한 (기본 200MB ≈ 5MB 사진 40장)
VISIT_MAX_PHOTO_BYTES_PER_USER=209715200
# 고아 사진 정리 배치. 로컬에서는 파일이 예고 없이 사라지지 않게 false 를 권장한다.
# docker compose 로 띄우면 기본 true 다.
VISIT_PHOTO_CLEANUP_ENABLED=false

# ----- 컨테이너 실행 (#86) -----
# docker compose 가 호스트에 노출할 서버 포트
SERVER_PORT=8080
